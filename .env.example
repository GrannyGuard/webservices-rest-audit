# Copy to .env and fill in real values:  cp .env.example .env
# The real .env is git-ignored — never commit credentials.

# OpenMRS core image tag. Pin a real version in test/prod; 'nightly' is dev-only.
OPENMRS_TAG=nightly

# Database
DB_NAME=openmrs

# Privileged MIGRATION account — full rights on the DB. OpenMRS/Liquibase use this to
# create and upgrade the schema at deploy time. Do not use it for steady-state runtime.
DB_USER=openmrs
DB_PASSWORD=openmrs
DB_ROOT_PASSWORD=change_me_root

# Least-privilege RUNTIME account — DML only (SELECT/INSERT/UPDATE/DELETE), can never
# DROP/ALTER the schema (NEN-7510 A.8.2/A.8.3). Created by
# docker/db-init/10-runtime-least-privilege.sh. In production, point
# OMRS_CONFIG_CONNECTION_USERNAME at this account once the schema has been migrated
# (see docker/README.md → "Least-privilege runtime database user").
DB_APP_USER=openmrs_app
DB_APP_PASSWORD=openmrs_app
